# 🎮 游戏档（fir）—— 目标：**每棵约 5000 三角形**（低配小游戏的英雄树量级）。
#
# 由 configs/low/fir.pbtxt 继续降：
#   levels   2   （2 = 主干 + 一级枝；细枝层被砍掉）
#   leaves   16   （每根末级枝的叶片上限）
#   leafScale 2.6   （叶子放大 —— 卡少 10 倍时必须靠"更少更大的叶簇"撑体积）
#   per_seg  1    / ring 3,3,3（都在配置里：export.per_seg / export.ring_count）
#
# 生成（只读配置，无命令行参数）：
#   gen/shape_gen --config configs/game/fir.pbtxt \
#       --out output/veg_shapes/fir_game.vegshape
#
# 杉树（Fir）—— 塔形、下垂枝、四级分枝。
#
# 直接吃 Sapling 的 douglas_fir 预设：它自带 4 级分枝 + 下垂枝 + 收尖的塔形冠，
# 是 9 个预设里最像杉/冷杉的一档，基本不用改形态参数。
#
# 注意：这棵树是**枝最密的**一档（约 4100 枝 / 1.26 万张卡），
# 生成耗时约 2 分钟 —— 慢的原因不在叶卡，而在导出脚本按枝数平方找父枝（见 README）。
version: 1
name: "fir"
description: "杉树：18m 高塔形冠、下垂侧枝、四级分枝。直接基于 douglas_fir 预设，只调尺寸与叶量。"

tree {
  preset: "douglas_fir"

  # 18 m：预设 scale=35 太夸张，缩到 14 得到 ~18m 的成年杉。
  scale: 14
  seed: 5

  # 四级分枝：主干 → 一级 → 二级 → 三级，这也是枝数爆炸的来源。
  levels: 2

  # 预设默认每枝 25 张卡；12 已经足够密（枝多，不需要每枝太多叶）。
  leaves: 16
  # 针叶树的卡理论上是"针叶簇"，这里给 0.55 让远看有体积。
  leafScale: 2.6
}

noise {
  # 杉树枝最密、侧枝最软：弯度按级递增（越细的枝越容易弯）。
  # 主干保持很直（0.03 = 18m 干只偏 54cm），否则塔形轮廓会歪掉。
  size_jitter: [0.10, 0.18, 0.16, 0.12]
  bend_longitudinal: [0.03, 0.07, 0.11, 0.12]
  bend_lateral: [0.015, 0.04, 0.08, 0.10]
}

export {
  per_seg: 1
  # 针叶：卡明显瘦长。
  leaf_aspect: 0.4
  anchor_mode: "bottom_left"
  leaf_type_desc: "杉针簇"
  # 针叶比松针还细长：弯曲幅度再小一点，避免细卡片卷成筒。
  leaf_bend_along: -0.06
  leaf_bend_across: 0.04
  leaf_bend_crease: 0.03
  ring_count: 3
  ring_count: 3
  ring_count: 3
}
