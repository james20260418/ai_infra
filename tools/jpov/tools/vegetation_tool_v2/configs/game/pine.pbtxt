# 🎮 游戏档（pine）—— 目标：**每棵约 5000 三角形**（低配小游戏的英雄树量级）。
#
# 由 configs/low/pine.pbtxt 继续降：
#   levels   2   （2 = 主干 + 一级枝；细枝层被砍掉）
#   leaves   20   （每根末级枝的叶片上限）
#   leafScale 2.4   （叶子放大 —— 卡少 10 倍时必须靠"更少更大的叶簇"撑体积）
#   per_seg  1    / ring 3,3,3（都在配置里：export.per_seg / export.ring_count）
#
# 生成（只读配置，无命令行参数）：
#   gen/shape_gen --config configs/game/pine.pbtxt \
#       --out output/veg_shapes/pine_game.vegshape
#
# 松树（Pine）—— 塔形冠 + 裸露主干 + 轮生侧枝。
#
# 直接吃 Sapling 自带的 small_pine 预设，只覆盖尺寸/种子/叶量：
# 预设本身的轮廓（裸干 + 上部轮生枝）就已经很像松，别乱动基部分枝参数。
version: 1
name: "pine"
description: "松树：高裸干、上部轮生侧枝、塔形冠。基于 small_pine 预设，只调尺寸与叶量。"

tree {
  preset: "small_pine"

  # 12 m 量级：视觉上是一棵成年松，但还没到"巨树"。
  scale: 12
  # 3 = 一个侧枝分布较均匀、不偏冠的种子（试过 1/3/5/7/13，3 最正）。
  levels: 2
  seed: 3

  # 松针本身很小，但要靠数量堆出体积：预设的 500 实际上只落几百张卡（很稀），
  # 55 是"远看有体积、近看还看得出枝"的平衡点。
  leaves: 20
  leafScale: 2.4
  leafScaleV: 0.12
}

noise {
  # 松树的主干本来就直：只给一点弓背（0.03 = 12m 干偏 36cm），侧枝略软。
  # 尺寸抖动让"每根侧枝都不一样长" —— 预设生成的枝太整齐，一眼看出是程序化的。
  size_jitter: [0.12, 0.18, 0.15]
  bend_longitudinal: [0.03, 0.06, 0.10]
  bend_lateral: [0.015, 0.04, 0.08]
}

export {
  # 松树的主干很直很长，8 段/贝塞尔已经看不出折线。
  per_seg: 1
  # 针叶细长：卡宽约为高的 0.45。
  leaf_aspect: 0.45
  anchor_mode: "bottom_left"
  leaf_type_desc: "松针簇"
  # 针叶细而硬：只给一点点下垂与杯度，中脉折痕几乎不要（折起来像纸片）。
  leaf_bend_along: -0.08
  leaf_bend_across: 0.05
  leaf_bend_crease: 0.04
  ring_count: 3
  ring_count: 3
  ring_count: 3
}
