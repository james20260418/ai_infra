# 杉树（Fir）—— 塔形、下垂枝、四级分枝。
#
# 直接吃 Sapling 的 douglas_fir 预设：它自带 4 级分枝 + 下垂枝 + 收尖的塔形冠，
# 是 9 个预设里最像杉/冷杉的一档，基本不用改形态参数。
#
# 注意：这棵树是**枝最密的**一档（约 4100 枝 / 1.26 万张卡），
# 生成耗时约 2 分钟 —— 慢的原因不在叶卡，而在导出脚本按枝数平方找父枝（见 README）。
version: 1
name: "fir"
description: "杉树：18m 高塔形冠、下垂侧枝、四级分枝。直接基于 douglas_fir 预设，只调尺寸与叶量。"

tree {
  preset: "douglas_fir"

  # 18 m：预设 scale=35 太夸张，缩到 14 得到 ~18m 的成年杉。
  scale: 14
  seed: 5

  # 四级分枝：主干 → 一级 → 二级 → 三级，这也是枝数爆炸的来源。
  levels: 4

  # 预设默认每枝 25 张卡；12 已经足够密（枝多，不需要每枝太多叶）。
  leaves: 12
  # 针叶树的卡理论上是"针叶簇"，这里给 0.55 让远看有体积。
  leafScale: 0.55
}

export {
  per_seg: 8
  # 针叶：卡明显瘦长。
  leaf_aspect: 0.4
  anchor_mode: "bottom_left"
  leaf_type_desc: "杉针簇"
}
