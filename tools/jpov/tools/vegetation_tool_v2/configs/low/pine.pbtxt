# ⚠️ 低配版（pine）—— 由 configs/pine.pbtxt 派生，只为把顶点数压到 6 万以下。
#
# 改了四处（其余与高配版完全一致）：
#   leaves      : 叶片数量（决定性因素：每张弯曲卡 9 顶点）
#   leafScale   : 叶片尺寸放大，用"更少更大的叶子"补回覆盖率
#   curveRes    : 每根枝的贝塞尔段数（这里留空 = 用预设值；改小会破坏父枝判定，见 README）
#   per_seg     : 每段贝塞尔的采样点数
# 环顶点数不在配置里，由命令行给：--ring-count 8,6,4
#
# 生成命令（环顶点数在命令行给，配置里没有这个字段）：
#   ./bazel-bin/tools/jpov/tools/vegetation_tool_v2/gen/shape_gen \
#     --config tools/jpov/tools/vegetation_tool_v2/configs/low/pine.pbtxt \
#     --out output/veg_shapes/pine_low.pbtxt --per-seg 8 --ring-count 8,6,4
#

# 松树（Pine）—— 塔形冠 + 裸露主干 + 轮生侧枝。
#
# 直接吃 Sapling 自带的 small_pine 预设，只覆盖尺寸/种子/叶量：
# 预设本身的轮廓（裸干 + 上部轮生枝）就已经很像松，别乱动基部分枝参数。
version: 1
name: "pine"
description: "松树：高裸干、上部轮生侧枝、塔形冠。基于 small_pine 预设，只调尺寸与叶量。"

tree {
  preset: "small_pine"

  # 12 m 量级：视觉上是一棵成年松，但还没到"巨树"。
  scale: 12
  # 3 = 一个侧枝分布较均匀、不偏冠的种子（试过 1/3/5/7/13，3 最正）。
  seed: 3

  # 松针本身很小，但要靠数量堆出体积：预设的 500 实际上只落几百张卡（很稀），
  # 55 是"远看有体积、近看还看得出枝"的平衡点。
  leaves: 18
  leafScale: 0.8
  leafScaleV: 0.12
}

noise {
  # 松树的主干本来就直：只给一点弓背（0.03 = 12m 干偏 36cm），侧枝略软。
  # 尺寸抖动让"每根侧枝都不一样长" —— 预设生成的枝太整齐，一眼看出是程序化的。
  size_jitter: [0.12, 0.18, 0.15]
  bend_longitudinal: [0.03, 0.06, 0.10]
  bend_lateral: [0.015, 0.04, 0.08]
}

export {
  # 松树的主干很直很长，8 段/贝塞尔已经看不出折线。
  per_seg: 2
  # 针叶细长：卡宽约为高的 0.45。
  leaf_aspect: 0.45
  anchor_mode: "bottom_left"
  leaf_type_desc: "松针簇"
  # 针叶细而硬：只给一点点下垂与杯度，中脉折痕几乎不要（折起来像纸片）。
  leaf_bend_along: -0.08
  leaf_bend_across: 0.05
  leaf_bend_crease: 0.04
}
