#!/usr/bin/env bash
# manta-run — 切到含 waveletNoiseTile.bin 的目录后再调 manta。
# Mantaflow 要求运行目录里有 waveletNoiseTile.bin；直接 `manta <script>` 常因缺该文件失败。
# 用法：manta-run [环境变量=值 ...] <scene.py>   （环境变量由 shell 正常传入，无需特殊处理）
set -euo pipefail

MANTA_ROOT="${MANTA_ROOT:-/opt/mantaflow}"
if [[ ! -f "${MANTA_ROOT}/waveletNoiseTile.bin" ]]; then
    echo "manta-run: 找不到 ${MANTA_ROOT}/waveletNoiseTile.bin（设 MANTA_ROOT 或先装好环境）" >&2
    exit 1
fi
cd "${MANTA_ROOT}"
exec manta "$@"
