# 手写立方体 OBJ — 用于 OBJ 加载器单元测试
# 覆盖: v/vt/vn 全分量、四边形面(fan 三角化)、负索引(相对索引)、重复 v 但不同 vt/vn(corner-splitting)
# 顶点数: 8(位置) / 24(拆分后 GPU 顶点)
# 每个位置 v_i 被 3 个不同面引用，每个面给该位置配一组独立的 vt/vn → 触发 corner-splitting

# ---- 位置(8 个) ----
v 0 0 0
v 1 0 0
v 1 1 0
v 0 1 0
v 0 0 1
v 1 0 1
v 1 1 1
v 0 1 1

# ---- UV(每个位置配 2 组, 共 16 个) ----
# 上面(bottom face)用下标 1-8, 顶面用下标 9-16
vt 0 0
vt 1 0
vt 1 1
vt 0 1
vt 0 0
vt 1 0
vt 1 1
vt 0 1
vt 0 0
vt 1 0
vt 1 1
vt 0 1
vt 0 0
vt 1 0
vt 1 1
vt 0 1

# ---- 法线(6 个, 每面一个) ----
vn 0 0 -1
vn 0 0 1
vn 0 -1 0
vn 0 1 0
vn -1 0 0
vn 1 0 0

# ---- 面(6 个四边形, 用负索引引用最后几个顶点演示相对索引) ----
# 底面 z=0, 法线 1
f 1/1/1 2/2/1 3/3/1 4/4/1
# 顶面 z=1, 法线 2 (用负索引: -1=v8,-2=v7,-3=v6,-4=v5)
f -4/9/2 -3/10/2 -2/11/2 -1/12/2
# 前面 y=0, 法线 3
f 1/5/3 2/6/3 6/-8/3 5/-4/3
# 后面 y=1, 法线 4
f 4/1/4 3/2/4 7/-2/4 8/-1/4
# 左面 x=0, 法线 5
f 1/5/5 5/6/5 8/-2/5 4/-4/5
# 右面 x=1, 法线 6
f 2/1/6 6/2/6 7/-2/6 3/-4/6
