# 材质立方体 — 6 面独立 UV，映射到 1:3 纹理图
# 纹理: [0, 1/3)=木头(前后)  [1/3, 2/3)=大理石(上下)  [2/3, 1)=锈金属(左右)
# 顶点数: 24（每面 4 个独立顶点，不共享）
# Cube 范围: [-0.5, 0.5]，以原点为中心


# ---- 位置(24 个，每面 4 个独立) ----
# 前面 z=+0.5 (normal +Z)
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5  0.5  0.5
v -0.5  0.5  0.5
# 后面 z=-0.5 (normal -Z)
v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5
v  0.5  0.5 -0.5
v -0.5  0.5 -0.5
# 上面 y=+0.5 (normal +Y)
v -0.5  0.5  0.5
v  0.5  0.5  0.5
v  0.5  0.5 -0.5
v -0.5  0.5 -0.5
# 下面 y=-0.5 (normal -Y)
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5 -0.5 -0.5
v -0.5 -0.5 -0.5
# 右面 x=+0.5 (normal +X)
v  0.5 -0.5  0.5
v  0.5 -0.5 -0.5
v  0.5  0.5 -0.5
v  0.5  0.5  0.5
# 左面 x=-0.5 (normal -X)
v -0.5 -0.5  0.5
v -0.5 -0.5 -0.5
v -0.5  0.5 -0.5
v -0.5  0.5  0.5


# ---- UV(24 个，每面 4 个独立) ----
# 纹理 768×256，每 panel 256×256
# Panel offsets in texture space (U coordinate):
#   木头: 0/768=0.0   → 256/768≈0.333
#   大理石: 256/768≈0.333 → 512/768≈0.667
#   金属: 512/768≈0.667 → 768/768=1.0
# 每 panel 内: U∈[0,1] 需要映射到对应 panel 范围

# 前面 — 木头 (U:0.0-0.333, V:0.0-1.0)
vt 0.000 0.000
vt 0.333 0.000
vt 0.333 1.000
vt 0.000 1.000
# 后面 — 木头 (U:0.0-0.333, V:0.0-1.0)
vt 0.000 0.000
vt 0.333 0.000
vt 0.333 1.000
vt 0.000 1.000
# 上面 — 大理石 (U:0.333-0.667, V:0.0-1.0)
vt 0.333 0.000
vt 0.667 0.000
vt 0.667 1.000
vt 0.333 1.000
# 下面 — 大理石 (U:0.333-0.667, V:0.0-1.0)
vt 0.333 0.000
vt 0.667 0.000
vt 0.667 1.000
vt 0.333 1.000
# 右面 — 锈金属 (U:0.667-1.0, V:0.0-1.0)
vt 0.667 0.000
vt 1.000 0.000
vt 1.000 1.000
vt 0.667 1.000
# 左面 — 锈金属 (U:0.667-1.0, V:0.0-1.0)
vt 0.667 0.000
vt 1.000 0.000
vt 1.000 1.000
vt 0.667 1.000


# ---- 法线(6 个) ----
vn 0 0 1
vn 0 0 -1
vn 0 1 0
vn 0 -1 0
vn 1 0 0
vn -1 0 0


# ---- 面(6 个四边形) ----
# 各面 fan 三角化后 CCW from outside
# 前面 (z=+0.5): 顶点 1-4, UV 1-4, 法线 1(+Z)
f 1/1/1 2/2/1 3/3/1 4/4/1
# 后面 (z=-0.5): 顶点 8/7/6/5, UV 5-8, 法线 2(-Z) — 反转使 CCW from outside
f 8/8/2 7/7/2 6/6/2 5/5/2
# 上面 (y=+0.5): 顶点 9-12, UV 9-12, 法线 3(+Y)
f 9/9/3 10/10/3 11/11/3 12/12/3
# 下面 (y=-0.5): 顶点 16/15/14/13, UV 13-16, 法线 4(-Y) — 反转
f 16/16/4 15/15/4 14/14/4 13/13/4
# 右面 (x=+0.5): 顶点 17-20, UV 17-20, 法线 5(+X)
f 17/17/5 18/18/5 19/19/5 20/20/5
# 左面 (x=-0.5): 顶点 24/23/22/21, UV 21-24, 法线 6(-X) — 反转
f 24/24/6 23/23/6 22/22/6 21/21/6
